{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DDR Price Snapshot",
  "type": "object",
  "required": ["schema_version", "date", "generated_at", "granules", "modules", "contract"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "currency_note": { "type": "string" },
    "granules": {
      "type": "array",
      "items": { "$ref": "#/definitions/price_item" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/definitions/price_item" }
    },
    "contract": {
      "type": "array",
      "items": { "$ref": "#/definitions/price_item" }
    },
    "fx": {
      "type": "object",
      "properties": {
        "usd_cny": { "type": ["number", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string" }
        }
      }
    },
    "data_quality": { "type": "string", "enum": ["high", "medium", "low", "partial", "failed"] },
    "data_quality_note": { "type": ["string", "null"] }
  },
  "definitions": {
    "price_item": {
      "type": "object",
      "required": ["id", "category", "price_usd"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string", "enum": ["DDR3", "DDR4", "DDR5", "LPDDR4", "LPDDR5"] },
        "density": { "type": ["string", "null"] },
        "spec": { "type": ["string", "null"] },
        "form": { "type": ["string", "null"] },
        "capacity": { "type": ["string", "null"] },
        "price_usd": { "type": ["number", "null"] },
        "change_dod_pct": { "type": ["number", "null"] },
        "change_wow_pct": { "type": ["number", "null"] },
        "currency": { "type": "string", "default": "USD" },
        "unit": { "type": "string" },
        "period": { "type": ["string", "null"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
