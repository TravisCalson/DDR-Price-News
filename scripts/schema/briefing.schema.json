{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DDR Daily Briefing",
  "type": "object",
  "required": ["schema_version", "date", "title", "summary", "body_markdown", "generated_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "body_markdown": { "type": "string" },
    "price_overview_markdown": { "type": ["string", "null"] },
    "supply_demand_points": { "type": "array", "items": { "type": "string" } },
    "outlook_markdown": { "type": ["string", "null"] },
    "watch_items": { "type": "array", "items": { "type": "string" } },
    "bullish_points": { "type": "array", "items": { "type": "string" } },
    "bearish_points": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "generated_at": { "type": "string" }
  }
}
