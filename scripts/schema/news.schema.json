{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DDR Industry News",
  "type": "object",
  "required": ["schema_version", "date", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "vendor", "title", "summary"],
        "properties": {
          "id": { "type": "string" },
          "vendor": { "type": "string", "enum": ["Samsung", "SK Hynix", "Micron", "CXMT", "Nanya", "Other"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "source_name": { "type": ["string", "null"] },
          "published_date": { "type": ["string", "null"] },
          "impact": { "type": "string", "enum": ["supply", "demand", "price", "tech", "other"] },
          "importance": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
